local function bwSeq(dark)
	local w, d = Color3.new(1, 1, 1), Color3.fromRGB(dark, dark, dark)
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, w),
		ColorSequenceKeypoint.new(0.36, w),
		ColorSequenceKeypoint.new(0.5, d),
		ColorSequenceKeypoint.new(0.64, w),
		ColorSequenceKeypoint.new(1, w),
	})
end
local BW_SEQ_TEXT = bwSeq(BW_BAND_TEXT)
local BW_SEQ_BORDER = bwSeq(BW_BAND_BORDER)

-- đổi 1 màu bất kỳ sang đen/trắng/xám
function bwGray(c, kind)
	if typeof(c) ~= "Color3" then return c end
	local r, g, b = c.R, c.G, c.B
	local sat = math.max(r, g, b) - math.min(r, g, b)
	local v = 0.299 * r + 0.587 * g + 0.114 * b
	if sat > 0.3 then
		if kind == "bg" then
			v = BW_HIGHLIGHT_GRAY / 255
		elseif kind == "tstroke" then
			v = 0
		else
			v = 1
		end
	elseif kind == "border" then
		v = math.max(v, 0.85)
	end
	return Color3.new(v, v, v)
end

local BW_PROPS = {
	BackgroundColor3 = "bg", TextColor3 = "text", TextStrokeColor3 = "tstroke",
	PlaceholderColor3 = "text", ImageColor3 = "image", ScrollBarImageColor3 = "image",
}
local bwSweeps = {} -- FIX: không dùng weak table (Roblox tự xoá Instance khỏi weak table -> màu không chạy)
local bwDone = setmetatable({}, { __mode = "k" })

local function bwSet(obj, prop, kind)
	local ok, cur = pcall(function() return obj[prop] end)
	if not ok or typeof(cur) ~= "Color3" then return end
	local nv = bwGray(cur, kind)
	if math.abs(nv.R - cur.R) + math.abs(nv.G - cur.G) + math.abs(nv.B - cur.B) > 0.01 then
		pcall(function() obj[prop] = nv end)
	end
end

local function bwGrayGradient(gr)
	pcall(function()
		local kps = {}
		for _, kp in ipairs(gr.Color.Keypoints) do
			table.insert(kps, ColorSequenceKeypoint.new(kp.Time, bwGray(kp.Value, "grad")))
		end
		local changed = false
		for i, kp in ipairs(gr.Color.Keypoints) do
			local a, b = kp.Value, kps[i].Value
			if math.abs(a.R - b.R) + math.abs(a.G - b.G) + math.abs(a.B - b.B) > 0.01 then changed = true end
		end
		if changed then gr.Color = ColorSequence.new(kps) end
	end)
end

local function bwAddSweep(obj, seq)
	for _, ch in ipairs(obj:GetChildren()) do
		if ch:IsA("UIGradient") then
			if not ch:GetAttribute("BWSweep") then bwGrayGradient(ch) end
			return
		end
	end
	local gr = Instance.new("UIGradient")
	gr.Name = "BWSweep"
	gr:SetAttribute("BWSweep", true)
	gr.Color = seq
	gr.Parent = obj
	bwSweeps[gr] = true
end

local function bwIsText(o)
	return o and (o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox"))
end

local ROUND_MIN = 16 -- bo góc tối thiểu cho panel / nút
local BTN_BG_MAX_TRANSP = 0.1 -- nền nút đậm: độ trong suốt tối đa
local BTN_BG_DARKEN = 0.55 -- nhân màu nền nút (nhỏ = tối hơn)
local function styleApply(obj)
	if obj:IsA("UICorner") then
		local function fix()
			local r = obj.CornerRadius
			if r.Scale == 0 and r.Offset < ROUND_MIN then obj.CornerRadius = UDim.new(0, ROUND_MIN) end
		end
		fix(); obj:GetPropertyChangedSignal("CornerRadius"):Connect(fix)
	elseif obj:IsA("GuiButton") then
		local function fixT()
			if obj:GetAttribute("KeepTransp") then return end
			local t = obj.BackgroundTransparency
			if t < 1 and t > BTN_BG_MAX_TRANSP then obj.BackgroundTransparency = BTN_BG_MAX_TRANSP end
		end
		local lastSet
		local function fixC()
			local c = obj.BackgroundColor3
			if lastSet then
				local l1 = (c.R + c.G + c.B) / 3
				local l2 = (lastSet.R + lastSet.G + lastSet.B) / 3
				if c == lastSet or math.abs(l1 - l2) < 0.04 then return end -- màu đã làm tối (hoặc bản đen trắng của nó)
			end
			lastSet = Color3.new(c.R * BTN_BG_DARKEN, c.G * BTN_BG_DARKEN, c.B * BTN_BG_DARKEN)
			obj.BackgroundColor3 = lastSet
		end
		fixT(); fixC()
		obj:GetPropertyChangedSignal("BackgroundTransparency"):Connect(fixT)
		obj:GetPropertyChangedSignal("BackgroundColor3"):Connect(fixC)
		if not obj:FindFirstChildOfClass("UICorner") and obj.BackgroundTransparency < 1 then
			Instance.new("UICorner", obj).CornerRadius = UDim.new(0, ROUND_MIN)
		end
	end
end

local function bwApply(obj)
	if bwDone[obj] then return end
	if obj:GetAttribute("NoBW") then return end
	if not obj:IsA("GuiObject") and obj.Parent and obj.Parent:GetAttribute("NoBW") then return end
	bwDone[obj] = true
	pcall(styleApply, obj)
	if obj:IsA("GuiObject") then
		for prop, kind in pairs(BW_PROPS) do bwSet(obj, prop, kind) end
		obj.Changed:Connect(function(prop)
			local kind = BW_PROPS[prop]
			if kind then bwSet(obj, prop, kind) end
		end)
		if bwIsText(obj) then
			local function tryText()
				if not (obj.Text == "" and obj.BackgroundTransparency >= 1) then
					bwAddSweep(obj, BW_SEQ_TEXT)
					return true
				end
			end
			if not tryText() then
				-- FIX: chữ được gán sau -> vẫn thêm vệt chạy
				local cn; cn = obj:GetPropertyChangedSignal("Text"):Connect(function()
					if tryText() and cn then cn:Disconnect() end
				end)
			end
		end
	elseif obj:IsA("UIStroke") then
		local isOutline = bwIsText(obj.Parent) and obj.ApplyStrokeMode == Enum.ApplyStrokeMode.Contextual
		local kind = isOutline and "tstroke" or "border"
		bwSet(obj, "Color", kind)
		obj.Changed:Connect(function(prop)
			if prop == "Color" then bwSet(obj, "Color", kind) end
		end)
		if not isOutline then bwAddSweep(obj, BW_SEQ_BORDER) end
	elseif obj:IsA("UIGradient") and not obj:GetAttribute("BWSweep") then
		-- gradient riêng của script: bỏ vệt chạy trùng, đổi gradient đó sang đen trắng
		local p = obj.Parent
		if p then
			for _, ch in ipairs(p:GetChildren()) do
				if ch ~= obj and ch:IsA("UIGradient") and ch:GetAttribute("BWSweep") then
					bwSweeps[ch] = nil
					ch:Destroy()
				end
			end
		end
		bwGrayGradient(obj)
		obj.Changed:Connect(function(prop)
			if prop == "Color" then bwGrayGradient(obj) end
		end)
	end
end

local bwHooked = setmetatable({}, { __mode = "k" })
local function bwHookGui(g)
	pcall(function()
		if bwHooked[g] or not g:IsA("ScreenGui") then return end
		local n = g.Name
		if n:find("Intro") or n:find("Overhead") then return end
		if n:sub(1, 13) ~= "VelinbleOnTop" and n ~= "CP_BigNotify" then return end
		bwHooked[g] = true
		for _, d in ipairs(g:GetDescendants()) do pcall(bwApply, d) end
		g.DescendantAdded:Connect(function(d)
			task.defer(function()
				if d.Parent then pcall(bwApply, d) end
			end)
		end)
	end)
end
local function bwWatch(container)
	if not container then return end
