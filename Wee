function _G.VelinbleOnTopApplyTpBg()
	pcall(function()
		local main = __votFindTpMain()
		if not main then return end
		local img = main:FindFirstChild("VelinbleBG")
		if not img then
			addBgImage(main, 12, getTpBgImage())
			img = main:FindFirstChild("VelinbleBG")
		end
		if img and img:IsA("ImageLabel") then
