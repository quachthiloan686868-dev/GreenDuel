 local p, onScreen = cam:WorldToViewportPoint(d.hrp.Position)
 d.tracer.From = Vector2.new(origin.X, origin.Y)
 d.tracer.To = Vector2.new(p.X, p.Y)
 d.tracer.Visible = onScreen and p.Z > 0
 elseif d.tracer then
