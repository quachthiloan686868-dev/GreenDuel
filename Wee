	        end
	    end)
	
	    local function disable()
	        if myToken ~= _chilliAntiDieToken then return end
	        _chilliAntiDieToken = _chilliAntiDieToken + 1
	        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	        pcall(function()
