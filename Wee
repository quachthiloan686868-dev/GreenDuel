function __votFindTpMain()
	local m = _G.__votTpMain
	if m and m.Parent then return m end
	local roots = { PlayerGui }
	pcall(function() table.insert(roots, game:GetService("CoreGui")) end)
	pcall(function() if gethui then table.insert(roots, gethui()) end end)
	for _, r in ipairs(roots) do
		local ok, g = pcall(function() return r:FindFirstChild("VelinbleOnTopHubbTP") end)
		local mm = ok and g and g:FindFirstChild("TPMain")
		if mm then _G.__votTpMain = mm; return mm end
	end
