 for _, parent in ipairs(parents) do
 for _, g in ipairs(parent:GetChildren()) do
 local n = (g.Name or ""):lower():gsub("%s+", "")
 -- giữ VelinbleOnTopStealBarOnly + bar script khác
 if n == "visstealbaronly" then
 -- keep
